{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "cib-launch-content-console",
  "version": "1",
  "title": "Marketing — lier les preuves et le contenu",
  "description": "2. Préparez les fiches Veille et Contenu dans les rôles existants. Sélectionnez une campagne, puis liez leurs identifiants et révisions exactes avec une preuve de revue. Aucune publication.",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "2. Préparez les fiches Veille et Contenu dans les rôles existants. Sélectionnez une campagne, puis liez leurs identifiants et révisions exactes avec une preuve de revue. Aucune publication."
        },
        {
          "type": "text",
          "value": "Ouvrez le formulaire par son titre dans les interactions disponibles. Les champs longs sont des mémos. Le responsable indiqué ne crée aucun droit AM."
        },
        {
          "type": "button",
          "label": "Actualiser le travail réel",
          "on_click": "refresh-usage"
        },
        {
          "type": "button",
          "label": "Actualiser les essais",
          "on_click": "refresh-qualification"
        },
        {
          "type": "text",
          "value": {
            "state": "listing.message"
          }
        },
        {
          "type": "table",
          "columns": [
            "kind",
            "id",
            "phase",
            "revision",
            "objectif"
          ],
          "rows": {
            "state": "listing.items"
          },
          "on_row_click": "select"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.message"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.permissions_summary"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.objectif"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.resultat_observe"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.preuve_ref"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "campaign_id": {
        "type": "string"
      },
      "campaign_revision": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      },
      "confirmation_resultat": {
        "type": "string"
      },
      "contenu_ref": {
        "type": "string"
      },
      "contenu_revision": {
        "type": "string"
      },
      "expected_revision": {
        "type": "string"
      },
      "jeu": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "permission": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "preuve_ref": {
        "type": "string"
      },
      "veille_ref": {
        "type": "string"
      },
      "veille_revision": {
        "type": "string"
      },
      "listing": {
        "type": "object"
      },
      "selected": {
        "type": "object"
      },
      "people": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "jeu": "usage",
    "campaign_id": "",
    "expected_revision": "0",
    "veille_ref": "",
    "veille_revision": "",
    "contenu_ref": "",
    "contenu_revision": "",
    "preuve_ref": "",
    "confirmation_manuelle": "non",
    "campaign_revision": "0",
    "confirmation_resultat": "non",
    "permission": "read",
    "kind": "campaign",
    "phase": "en_cours",
    "listing": {
      "items": [],
      "message": "Aucune liste chargée.",
      "summary": {}
    },
    "selected": {
      "record": {},
      "prefill": {
        "jeu": "usage",
        "campaign_id": "",
        "expected_revision": "0",
        "veille_ref": "",
        "veille_revision": "",
        "contenu_ref": "",
        "contenu_revision": "",
        "preuve_ref": "",
        "confirmation_manuelle": "non",
        "campaign_revision": "0",
        "confirmation_resultat": "non",
        "permission": "read",
        "kind": "campaign",
        "phase": "en_cours"
      },
      "message": "Aucune fiche sélectionnée."
    },
    "people": {
      "people": []
    }
  },
  "events": [
    {
      "event_id": "refresh-usage",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-launch-list",
        "input": {
          "jeu": "usage",
          "kind": "campaign"
        }
      },
      "result_to_state": "listing"
    },
    {
      "event_id": "refresh-qualification",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-launch-list",
        "input": {
          "jeu": "qualification",
          "kind": "campaign"
        }
      },
      "result_to_state": "listing"
    },
    {
      "event_id": "select",
      "trigger": "table.row_click",
      "workflow": {
        "workflow_id": "cib-launch-read",
        "input": {
          "jeu": "{{ event.payload.item.jeu }}",
          "kind": "{{ event.payload.item.kind }}",
          "id": "{{ event.payload.item.id }}",
          "form_id": "content"
        }
      },
      "result_to_state": "selected"
    },
    {
      "event_id": "save",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-launch-content-link",
        "input": {
          "jeu": "{{ state.jeu }}",
          "campaign_id": "{{ state.campaign_id }}",
          "expected_revision": "{{ state.expected_revision }}",
          "veille_ref": "{{ state.veille_ref }}",
          "veille_revision": "{{ state.veille_revision }}",
          "contenu_ref": "{{ state.contenu_ref }}",
          "contenu_revision": "{{ state.contenu_revision }}",
          "preuve_ref": "{{ state.preuve_ref }}",
          "confirmation_manuelle": "{{ state.confirmation_manuelle }}"
        }
      },
      "result_to_state": "selected"
    }
  ]
}
