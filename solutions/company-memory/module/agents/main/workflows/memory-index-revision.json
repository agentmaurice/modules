{
  "$schema": "agentmaurice.workflow/v2",
  "schema_version": 2,
  "kind": "workflow",
  "workflow_id": "memory-index-revision",
  "version": "2",
  "title": "Indexer une révision validée dans Memory et Brain",
  "forms": [
    {
      "id": "submit",
      "title": "Saisie manuelle",
      "fields": [
        {
          "name": "proposal_id",
          "title": "Révision",
          "type": "string",
          "required": true
        },
        {
          "name": "confirmation_manuelle",
          "title": "Confirmer l’indexation interne",
          "type": "select",
          "required": true,
          "options": [
            {
              "label": "Oui",
              "value": "oui"
            },
            {
              "label": "Non",
              "value": "non"
            }
          ]
        }
      ],
      "actions_on_submit": [
        "validate",
        "revalidate",
        "prepare",
        "store-memory",
        "read-back",
        "check-copy",
        "index-brain",
        "finish"
      ]
    }
  ],
  "actions": [
    {
      "id": "validate",
      "type": "code_execution",
      "code": "const x={{ json . }}; if(typeof x.proposal_id!==\"string\"||!/^[a-z0-9][a-z0-9_-]{0,63}$/.test(x.proposal_id)) throw new Error(\"invalid_slug\"); if(x.confirmation_manuelle!==\"oui\") throw new Error(\"manual_confirmation_required\"); return {proposal_id:x.proposal_id};",
      "output_key": "request"
    },
    {
      "id": "revalidate",
      "type": "workflow_call",
      "workflow_id": "memory-query",
      "workflow_version": "2",
      "execution": "sync",
      "timeout_ms": 60000,
      "input": {
        "proposal_id": "{{ request.proposal_id }}"
      },
      "output_key": "revision"
    },
    {
      "id": "prepare",
      "type": "code_execution",
      "code": "const r=({{ json .revision }}).data; const q={{ json .request }}; if(!r||r.status!==\"validated\"||r.proposal_id!==q.proposal_id||typeof r.answer!==\"string\"||!Array.isArray(r.citations)||!r.citations.length) throw new Error(\"validated_revision_required\"); return {proposal_id:r.proposal_id,answer:r.answer,citations:r.citations,expires_at:r.expires_at,checked_at:r.checked_at,document_uri:\"company-memory://revisions/\"+r.proposal_id};",
      "output_key": "record"
    },
    {
      "id": "store-memory",
      "type": "tool_call",
      "tool": "memory.entities.upsert",
      "params": {
        "tenant_id": "company-memory",
        "entityType": "company_memory_revision",
        "items": [
          {
            "externalId": "{{ record.proposal_id }}",
            "name": "{{ record.answer }}",
            "status": "validated",
            "attributes": {
              "citations": "{{ record.citations }}",
              "expires_at": "{{ record.expires_at }}",
              "document_uri": "{{ record.document_uri }}"
            }
          }
        ],
        "source": {
          "system": "company-memory-module",
          "timestamp": "{{ record.checked_at }}"
        },
        "writer": {
          "appId": "company-memory",
          "actorId": "memory-index-revision",
          "actorType": "system"
        }
      },
      "output_key": "stored"
    },
    {
      "id": "read-back",
      "type": "tool_call",
      "tool": "memory.query",
      "params": {
        "tenant_id": "company-memory",
        "sql": "SELECT external_id, name FROM v_entities WHERE external_id = ?",
        "params": {
          "revision": "{{ record.proposal_id }}"
        },
        "maxRows": 2,
        "timeoutMs": 10000
      },
      "output_key": "rows"
    },
    {
      "id": "check-copy",
      "type": "code_execution",
      "code": "const r={{ json .record }}; const m={{ json .rows }}; if(!Array.isArray(m.rows)||m.rows.length!==1||m.rows[0][0]!==r.proposal_id||m.rows[0][1]!==r.answer) throw new Error(\"memory_readback_mismatch\"); return true;",
      "output_key": "memory_persisted"
    },
    {
      "id": "index-brain",
      "type": "tool_call",
      "tool": "brain.document.upsert",
      "params": {
        "tenant_id": "company-memory",
        "source_uri": "company-memory://revisions",
        "document_uri": "{{ record.document_uri }}",
        "content": "{{ record.answer }}",
        "content_type": "text/plain",
        "metadata": {
          "proposal_id": "{{ record.proposal_id }}",
          "citations": "{{ record.citations }}",
          "expires_at": "{{ record.expires_at }}"
        },
        "wait_for_job": true
      },
      "output_key": "indexed"
    },
    {
      "id": "finish",
      "type": "code_execution",
      "code": "const b={{ json .indexed }}; if(b.status!==\"completed\") throw new Error(\"brain_index_not_completed\"); return \"indexed\";",
      "output_key": "status"
    }
  ],
  "output": {
    "status": "{{ status }}",
    "proposal_id": "{{ record.proposal_id }}",
    "document_uri": "{{ record.document_uri }}",
    "citations": "{{ record.citations }}",
    "warning": "exact_revision_not_current_page",
    "memory_persisted": "{{ memory_persisted }}",
    "brain_indexed": true
  }
}
