{
  "$schema": "agentmaurice.workflow/v2",
  "schema_version": 2,
  "kind": "workflow",
  "workflow_id": "memory-resolve-candidate",
  "version": "1",
  "title": "Revérifier un candidat de recherche",
  "actions": [
    {
      "id": "validate",
      "type": "code_execution",
      "code": "const x=({{ json . }}).candidate; if(!x||typeof x.proposal_id!==\"string\"||!/^[a-z0-9][a-z0-9_-]{0,63}$/.test(x.proposal_id)) throw new Error(\"invalid_candidate\"); return {proposal_id:x.proposal_id};",
      "output_key": "request"
    },
    {
      "id": "revalidate",
      "type": "workflow_call",
      "workflow_id": "memory-query",
      "workflow_version": "2",
      "execution": "sync",
      "timeout_ms": 60000,
      "input": {
        "proposal_id": "{{ request.proposal_id }}"
      },
      "output_key": "revision"
    }
  ],
  "output": {
    "status": "{{ revision.data.status }}",
    "answer": "{{ revision.data.answer }}",
    "citations": "{{ revision.data.citations }}",
    "proposal_id": "{{ revision.data.proposal_id }}",
    "warning": "{{ revision.data.warning }}",
    "checked_at": "{{ revision.data.checked_at }}",
    "expires_at": "{{ revision.data.expires_at }}"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "candidate"
    ],
    "properties": {
      "candidate": {
        "type": "object",
        "required": [
          "proposal_id"
        ],
        "properties": {
          "proposal_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
