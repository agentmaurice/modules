{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "cib-admin-console",
  "version": "3",
  "title": "Company-in-a-Box administration",
  "description": "Read and perform manual administrative operations without creating accounts or sending email invitations.",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Manage people, their service access and mandates. A directory entry does not create a user account."
        },
        {
          "type": "button",
          "label": "Refresh overview",
          "on_click": "refresh"
        },
        {
          "type": "section",
          "title": "People",
          "children": [
            {
              "type": "table",
              "columns": [
                "person_id",
                "display_name",
                "platform_user_id"
              ],
              "column_labels": {
                "person_id": "Reference",
                "display_name": "Name",
                "platform_user_id": "Linked identity"
              },
              "rows": {
                "state": "overview.people"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Business roles",
          "children": [
            {
              "type": "table",
              "columns": [
                "person_id",
                "role_label"
              ],
              "column_labels": {
                "person_id": "Person",
                "role_label": "Role"
              },
              "rows": {
                "state": "overview.grants_display"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Application members",
          "children": [
            {
              "type": "table",
              "columns": [
                "user_id"
              ],
              "column_labels": {
                "user_id": "Identity"
              },
              "rows": {
                "state": "overview.application_people"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Mandates",
          "children": [
            {
              "type": "metric",
              "label": "Current mandates",
              "value": {
                "state": "overview.mandate_count"
              }
            },
            {
              "type": "table",
              "columns": [
                "mandate_id",
                "status_label"
              ],
              "column_labels": {
                "mandate_id": "Mandate",
                "status_label": "Status"
              },
              "rows": {
                "state": "overview.approval_mandates_display"
              }
            }
          ]
        },
        {
          "type": "text",
          "value": {
            "state": "overview.message"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "result.message"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "overview": {
        "type": "object"
      },
      "result": {
        "type": "object"
      },
      "operation": {
        "type": "string"
      },
      "person_id": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      },
      "target_platform_user_id": {
        "type": "string"
      },
      "role_key": {
        "type": "string"
      },
      "mandate_id": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      }
    }
  },
  "initial_state": {
    "overview": {
      "people": [],
      "grants": [],
      "grants_display": [],
      "application_people": [],
      "approval_mandates": [],
      "approval_mandates_display": [],
      "mandate_count": 0
    },
    "result": {
      "message": "No overview read."
    },
    "operation": "",
    "person_id": "",
    "display_name": "",
    "target_platform_user_id": "",
    "role_key": "",
    "mandate_id": "",
    "reason": "",
    "confirmation_manuelle": "false"
  },
  "events": [
    {
      "event_id": "refresh",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-admin-overview",
        "input": {}
      },
      "result_to_state": "overview"
    },
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-admin-manage",
        "input": {
          "operation": "{{ state.operation }}",
          "person_id": "{{ state.person_id }}",
          "display_name": "{{ state.display_name }}",
          "target_platform_user_id": "{{ state.target_platform_user_id }}",
          "role_key": "{{ state.role_key }}",
          "mandate_id": "{{ state.mandate_id }}",
          "reason": "{{ state.reason }}",
          "confirmation_manuelle": "{{ state.confirmation_manuelle }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
