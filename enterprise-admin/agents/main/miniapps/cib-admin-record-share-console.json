{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "cib-admin-record-share-console",
  "version": "2",
  "title": "Administration — share a historical record",
  "description": "Share one record using metadata already read; no business record body is read and no bulk transfer or sharing is performed.",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Copy the four known fields from the historical records console: namespace, record key, revision and member identifier. Do not enter secrets. One record and one member are handled at a time; the administrator remains the custodian."
        },
        {
          "type": "text",
          "value": "Open the “Administration — share a historical record” form in the available interactions, then confirm sharing or removal."
        },
        {
          "type": "text",
          "value": {
            "state": "result.message"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "namespace": {
        "type": "string"
      },
      "record_key": {
        "type": "string"
      },
      "expected_revision": {
        "type": "string"
      },
      "subject_user_id": {
        "type": "string"
      },
      "permission": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "namespace": "cib-cases",
    "record_key": "",
    "expected_revision": "",
    "subject_user_id": "",
    "permission": "read",
    "confirmation_manuelle": "non",
    "result": {
      "message": "No action."
    }
  },
  "events": [
    {
      "event_id": "share",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-admin-record-share",
        "input": {
          "namespace": "{{ state.namespace }}",
          "record_key": "{{ state.record_key }}",
          "expected_revision": "{{ state.expected_revision }}",
          "subject_user_id": "{{ state.subject_user_id }}",
          "permission": "{{ state.permission }}",
          "confirmation_manuelle": "{{ state.confirmation_manuelle }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
