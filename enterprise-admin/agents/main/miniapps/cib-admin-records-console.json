{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "cib-admin-records-console",
  "version": "2",
  "title": "Administration — historical records",
  "description": "Inspect metadata and ACL sharing for individual historical records. Records remain private by default.",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Enter one record at a time. The administrator remains the custodian; bulk transfer and sharing are unavailable."
        },
        {
          "type": "button",
          "label": "Read ACL metadata",
          "on_click": "read"
        },
        {
          "type": "button",
          "label": "Load existing members",
          "on_click": "people"
        },
        {
          "type": "section",
          "title": "ACL metadata",
          "children": [
            {
              "type": "text",
              "value": {
                "state": "read.message"
              }
            },
            {
              "type": "table",
              "columns": [
                "namespace_label",
                "record_key",
                "revision",
                "owner_user_id",
                "body_included"
              ],
              "column_labels": {
                "namespace_label": "Record type",
                "record_key": "Record key",
                "revision": "Revision",
                "owner_user_id": "Owner",
                "body_included": "Body included"
              },
              "rows": {
                "state": "read.display_rows"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Existing members — click to select",
          "children": [
            {
              "type": "table",
              "columns": [
                "user_id",
                "display_name"
              ],
              "rows": {
                "state": "people.people"
              },
              "on_row_click": "select-person"
            }
          ]
        },
        {
          "type": "section",
          "title": "Individual sharing",
          "children": [
            {
              "type": "text",
              "value": {
                "state": "people.selected_target.display_name"
              }
            },
            {
              "type": "text",
              "value": "To share or remove access, open cib-admin-record-share-console from navigation and copy the known namespace, key, revision and member."
            },
            {
              "type": "text",
              "value": {
                "state": "share.message"
              }
            }
          ]
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "read": {
        "type": "object"
      },
      "people": {
        "type": "object"
      },
      "share": {
        "type": "object"
      },
      "namespace": {
        "type": "string"
      },
      "record_key": {
        "type": "string"
      },
      "expected_revision": {
        "type": "string"
      },
      "subject_user_id": {
        "type": "string"
      },
      "permission": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      }
    }
  },
  "initial_state": {
    "read": {
      "message": "No record read.",
      "rows": [],
      "display_rows": []
    },
    "people": {
      "message": "No members loaded.",
      "people": [],
      "selected_target": null
    },
    "share": {
      "message": "No action.",
      "rows": []
    },
    "namespace": "cib-cases",
    "record_key": "",
    "expected_revision": "",
    "subject_user_id": "",
    "permission": "read",
    "confirmation_manuelle": "non"
  },
  "events": [
    {
      "event_id": "read",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-admin-record-read",
        "input": {
          "namespace": "{{ state.namespace }}",
          "record_key": "{{ state.record_key }}"
        }
      },
      "result_to_state": "read"
    },
    {
      "event_id": "people",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-admin-record-people",
        "input": {
          "namespace": "{{ state.read.namespace }}",
          "record_key": "{{ state.read.record_key }}"
        }
      },
      "result_to_state": "people"
    },
    {
      "event_id": "select-person",
      "trigger": "table.row_click",
      "workflow": {
        "workflow_id": "cib-admin-record-people",
        "input": {
          "namespace": "{{ state.read.namespace }}",
          "record_key": "{{ state.read.record_key }}",
          "subject_user_id": "{{ event.payload.item.user_id }}"
        }
      },
      "result_to_state": "people"
    },
    {
      "event_id": "share",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-admin-record-share",
        "input": {
          "namespace": "{{ state.read.namespace }}",
          "record_key": "{{ state.read.record_key }}",
          "expected_revision": "{{ state.read.revision }}",
          "subject_user_id": "{{ state.people.selected_target.user_id }}",
          "permission": "{{ state.permission }}",
          "confirmation_manuelle": "{{ state.confirmation_manuelle }}"
        }
      },
      "result_to_state": "share"
    }
  ]
}
