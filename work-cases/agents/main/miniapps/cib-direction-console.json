{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "cib-direction-console",
  "version": "4",
  "title": "Management briefing",
  "description": "ACL projection of shared cases, without additional authority.",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Internal ACL management briefing. Entries are already filtered by the broker."
        },
        {
          "type": "metric",
          "label": "Total accessible",
          "value": {
            "state": "result.summary.total"
          }
        },
        {
          "type": "text",
          "value": "Blocked cases"
        },
        {
          "type": "text",
          "value": {
            "state": "result.summary.blocked_count"
          }
        },
        {
          "type": "text",
          "value": "Cases ready for review"
        },
        {
          "type": "text",
          "value": {
            "state": "result.summary.ready_count"
          }
        },
        {
          "type": "table",
          "columns": [
            "case_id",
            "status_label",
            "priority_label",
            "service_label",
            "role_label",
            "prochaine_action"
          ],
          "column_labels": {
            "case_id": "Case",
            "status_label": "Declared status",
            "priority_label": "Priority",
            "service_label": "Service",
            "role_label": "Owner role",
            "prochaine_action": "Next action"
          },
          "rows": {
            "state": "result.items"
          },
          "on_row_click": "select"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.message"
          }
        },
        {
          "type": "section",
          "title": "Selected case",
          "children": [
            {
              "type": "text",
              "value": "Revision"
            },
            {
              "type": "text",
              "value": {
                "state": "selected.revision"
              }
            },
            {
              "type": "text",
              "value": "Permissions"
            },
            {
              "type": "text",
              "value": {
                "state": "selected.permissions_summary"
              }
            },
            {
              "type": "text",
              "value": "Objective"
            },
            {
              "type": "text",
              "value": {
                "state": "selected.record.objectif"
              }
            },
            {
              "type": "text",
              "value": {
                "state": "selected.record.critere_fin"
              }
            },
            {
              "type": "text",
              "value": {
                "state": "selected.record.prochaine_action"
              }
            }
          ]
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "jeu": {
        "type": "string"
      },
      "result": {
        "type": "object"
      },
      "selected": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "jeu": "usage",
    "result": {
      "items": [],
      "summary": {
        "total": 0,
        "blocked": [],
        "blocked_count": 0,
        "ready": [],
        "ready_count": 0
      },
      "message": "No briefing viewed."
    },
    "selected": {
      "content": "",
      "revision": 0,
      "permissions": {},
      "permissions_summary": "Read: no · Write: no · Share: no",
      "share_count": 0
    }
  },
  "events": [
    {
      "event_id": "brief",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-direction-brief",
        "input": {
          "jeu": "{{ state.jeu }}"
        }
      },
      "result_to_state": "result"
    },
    {
      "event_id": "select",
      "trigger": "table.row_click",
      "workflow": {
        "workflow_id": "cib-case-read",
        "input": {
          "jeu": "{{ state.jeu }}",
          "case_id": "{{ event.payload.item.case_id }}"
        }
      },
      "result_to_state": "selected"
    }
  ]
}
