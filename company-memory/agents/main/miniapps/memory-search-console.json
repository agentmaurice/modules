{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "memory-search-console",
  "title": "Memory — keyword search",
  "description": "Manual action in dedicated memory; no external publication.",
  "version": "3",
  "ui": {
    "renderer": "component",
    "component": "company-memory",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Exact, sourced revisions; search does not guarantee the latest version of a page."
        },
        {
          "type": "text",
          "value": {
            "state": "result.status"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "result.summary"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "query": "",
    "result": {}
  },
  "events": [
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "memory-search",
        "input": {
          "query": "{{ state.query }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
