{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "memory-review",
  "title": "Memory — manual review",
  "description": "Load a proposal, read its evidence, then make a manual decision.",
  "version": "5",
  "ui": {
    "renderer": "component",
    "component": "company-memory",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Proposal saved — inspect before deciding."
        },
        {
          "type": "text",
          "value": "Proposed title"
        },
        {
          "type": "text",
          "value": {
            "state": "proposal_id.title"
          }
        },
        {
          "type": "text",
          "value": "Proposed text"
        },
        {
          "type": "text",
          "value": {
            "state": "proposal_id.content"
          }
        },
        {
          "type": "text",
          "value": "Evidence excerpt"
        },
        {
          "type": "text",
          "value": {
            "state": "proposal_id.evidence_quote"
          }
        },
        {
          "type": "text",
          "value": "Stored source"
        },
        {
          "type": "text",
          "value": {
            "state": "proposal_id.source_content"
          }
        },
        {
          "type": "text",
          "value": "Source reference"
        },
        {
          "type": "text",
          "value": {
            "state": "proposal_id.source_ref"
          }
        },
        {
          "type": "text",
          "value": "Review before the start of this date (UTC)"
        },
        {
          "type": "text",
          "value": {
            "state": "proposal_id.review_due"
          }
        },
        {
          "type": "button",
          "label": "Validate this proposal",
          "on_click": "validate"
        },
        {
          "type": "button",
          "label": "Refuse this proposal",
          "on_click": "refuse"
        },
        {
          "type": "button",
          "label": "Flag a contradiction",
          "on_click": "dispute"
        },
        {
          "type": "text",
          "value": "Decision recorded"
        },
        {
          "type": "text",
          "value": {
            "state": "proposal_id.review.decision"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "proposal_id": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "proposal_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "evidence_quote": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "source_content": {
                "type": "string"
              },
              "review_due": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "review": {
                "type": "object"
              }
            }
          }
        ]
      },
      "selected": {
        "type": "object"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "proposal_id": "",
    "selected": {},
    "result": {}
  },
  "events": [
    {
      "event_id": "inspect",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "memory-inspect",
        "input": {
          "proposal_id": "{{ state.proposal_id }}"
        }
      },
      "result_to_state": "proposal_id"
    },
    {
      "event_id": "validate",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "memory-review-update",
        "input": {
          "proposal_id": "{{ state.proposal_id.proposal_id }}",
          "decision": "validated",
          "review_note": "Review from the MiniApp",
          "confirmation_manuelle": "oui"
        }
      },
      "result_to_state": "proposal_id"
    },
    {
      "event_id": "refuse",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "memory-review-update",
        "input": {
          "proposal_id": "{{ state.proposal_id.proposal_id }}",
          "decision": "refused",
          "review_note": "Review from the MiniApp",
          "confirmation_manuelle": "oui"
        }
      },
      "result_to_state": "proposal_id"
    },
    {
      "event_id": "dispute",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "memory-review-update",
        "input": {
          "proposal_id": "{{ state.proposal_id.proposal_id }}",
          "decision": "disputed",
          "review_note": "Review from the MiniApp",
          "confirmation_manuelle": "oui"
        }
      },
      "result_to_state": "proposal_id"
    }
  ]
}
