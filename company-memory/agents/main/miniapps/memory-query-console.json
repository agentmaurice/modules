{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "memory-query-console",
  "title": "Memory — read a revision",
  "description": "Native manual input and reading interface, without LLM, web or external effects.",
  "version": "5",
  "ui": {
    "renderer": "component",
    "component": "company-memory",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Manual mode: supplied data is treated as data, never as instructions."
        },
        {
          "type": "text",
          "value": "Status"
        },
        {
          "type": "text",
          "value": {
            "state": "result.status"
          }
        },
        {
          "type": "text",
          "value": "Superseded by"
        },
        {
          "type": "text",
          "value": {
            "state": "result.superseded_by"
          }
        },
        {
          "type": "text",
          "value": "Validated knowledge"
        },
        {
          "type": "text",
          "value": {
            "state": "result.answer"
          }
        },
        {
          "type": "text",
          "value": "Cited source"
        },
        {
          "type": "text",
          "value": {
            "state": "result.citations"
          }
        },
        {
          "type": "text",
          "value": "This view covers the requested revision. It does not guarantee that it is the latest."
        },
        {
          "type": "text",
          "value": "Review deadline (UTC)"
        },
        {
          "type": "text",
          "value": {
            "state": "result.expires_at"
          }
        },
        {
          "type": "text",
          "value": "Checked at"
        },
        {
          "type": "text",
          "value": {
            "state": "result.checked_at"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "proposal_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "proposal_id": "",
    "result": {}
  },
  "events": [
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "memory-query",
        "input": {
          "proposal_id": "{{ state.proposal_id }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
