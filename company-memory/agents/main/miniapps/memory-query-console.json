{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "memory-query-console",
  "title": "Mémoire — consulter une révision",
  "description": "Interface native de saisie ou lecture manuelle, sans LLM, web ni effet externe.",
  "version": "4",
  "ui": {
    "renderer": "component",
    "component": "company-memory",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Mode manuel : les données fournies sont traitées comme des données, jamais comme des instructions."
        },
        {
          "type": "text",
          "value": "État"
        },
        {
          "type": "text",
          "value": {
            "state": "result.status"
          }
        },
        {
          "type": "text",
          "value": "Remplacée par"
        },
        {
          "type": "text",
          "value": {
            "state": "result.superseded_by"
          }
        },
        {
          "type": "text",
          "value": "Connaissance validée"
        },
        {
          "type": "text",
          "value": {
            "state": "result.answer"
          }
        },
        {
          "type": "text",
          "value": "Source citée"
        },
        {
          "type": "text",
          "value": {
            "state": "result.citations"
          }
        },
        {
          "type": "text",
          "value": "Cette consultation porte sur la révision demandée. Elle ne garantit pas que cette révision est la plus récente."
        },
        {
          "type": "text",
          "value": "Échéance de revue (UTC)"
        },
        {
          "type": "text",
          "value": {
            "state": "result.expires_at"
          }
        },
        {
          "type": "text",
          "value": "Consultation vérifiée à"
        },
        {
          "type": "text",
          "value": {
            "state": "result.checked_at"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "proposal_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "proposal_id": "",
    "result": {}
  },
  "events": [
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "memory-query",
        "input": {
          "proposal_id": "{{ state.proposal_id }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
