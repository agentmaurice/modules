{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "memory-propose",
  "title": "Memory — propose",
  "description": "Native manual input and reading interface, without LLM, web or external effects.",
  "version": "4",
  "ui": {
    "renderer": "component",
    "component": "company-memory",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Manual mode: supplied data is treated as data, never as instructions."
        },
        {
          "type": "text",
          "value": "Status"
        },
        {
          "type": "text",
          "value": {
            "state": "result.status"
          }
        },
        {
          "type": "text",
          "value": "Validated knowledge"
        },
        {
          "type": "text",
          "value": "Cited source"
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "proposal_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "source_id": {
        "type": "string"
      },
      "evidence_quote": {
        "type": "string"
      },
      "review_due": {
        "type": "string"
      },
      "previous_revision": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "proposal_id": "",
    "title": "",
    "content": "",
    "source_id": "",
    "evidence_quote": "",
    "review_due": "",
    "previous_revision": "",
    "confirmation_manuelle": "",
    "result": {}
  },
  "events": [
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "memory-propose-update",
        "input": {
          "proposal_id": "{{ state.proposal_id }}",
          "title": "{{ state.title }}",
          "content": "{{ state.content }}",
          "source_id": "{{ state.source_id }}",
          "evidence_quote": "{{ state.evidence_quote }}",
          "review_due": "{{ state.review_due }}",
          "previous_revision": "{{ state.previous_revision }}",
          "confirmation_manuelle": "{{ state.confirmation_manuelle }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
