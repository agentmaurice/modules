{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Données métier de la newsletter de lancement",
  "description": "Les URL (bouton, visuel, désabonnement) sont absolues en https ; le gabarit n'envoie rien (le rendu produit html, txt et eml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["preheader", "headline", "intro", "hero_image_url", "hero_image_alt", "features", "cta_label", "cta_url", "unsubscribe_url"],
  "properties": {
    "subject": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Objet de l'e-mail : en-tête Subject de l'eml, sans effet sur html et txt." },
    "preheader": { "type": "string", "maxLength": 140, "description": "Texte d'aperçu affiché par la messagerie." },
    "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "intro": { "type": "string", "minLength": 1 },
    "hero_image_url": { "type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$", "not": { "pattern": "\\s" } },
    "hero_image_alt": { "type": "string", "minLength": 1 },
    "features_title": { "type": "string" },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cta_label": { "type": "string", "minLength": 1, "maxLength": 60 },
    "cta_url": { "type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$", "not": { "pattern": "\\s" } },
    "unsubscribe_url": { "type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$", "not": { "pattern": "\\s" } }
  }
}
