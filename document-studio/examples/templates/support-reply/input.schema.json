{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Données métier de la réponse du support",
  "description": "Les URL sont absolues en https ; le gabarit n'envoie rien (le rendu produit html, txt et eml).",
  "type": "object",
  "required": ["customer_name", "preheader", "paragraphs", "agent_name", "agent_role", "ticket_url", "unsubscribe_url"],
  "properties": {
    "subject": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Objet de l'e-mail : en-tête Subject de l'eml, sans effet sur html et txt." },
    "customer_name": { "type": "string", "minLength": 1 },
    "preheader": { "type": "string", "maxLength": 140, "description": "Texte d'aperçu affiché par la messagerie." },
    "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "steps_title": { "type": "string" },
    "steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "agent_name": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string", "minLength": 1 },
    "ticket_url": { "type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$", "not": { "pattern": "\\s" } },
    "unsubscribe_url": { "type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?$", "not": { "pattern": "\\s" } }
  }
}
