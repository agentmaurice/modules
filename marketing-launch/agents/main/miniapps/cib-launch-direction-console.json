{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "cib-launch-direction-console",
  "version": "2",
  "title": "Management — launch and first results",
  "description": "5. This summary counts only records you can access. Requests and first results are distinct. Attribution, conversion and time savings remain unmeasured.",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "5. This summary counts only records you can access. Requests and first results are distinct. Attribution, conversion and time savings remain unmeasured."
        },
        {
          "type": "text",
          "value": "Open the form by its title in the available interactions. Long fields are notes. The named owner grants no AM permissions."
        },
        {
          "type": "button",
          "label": "Refresh real work",
          "on_click": "refresh-usage"
        },
        {
          "type": "button",
          "label": "Refresh trials",
          "on_click": "refresh-qualification"
        },
        {
          "type": "text",
          "value": {
            "state": "listing.message"
          }
        },
        {
          "type": "table",
          "columns": [
            "kind_label",
            "id",
            "phase_label",
            "revision",
            "objectif"
          ],
          "column_labels": {
            "kind_label": "Type",
            "id": "ID",
            "phase_label": "Stage",
            "revision": "Revision",
            "objectif": "Objective"
          },
          "rows": {
            "state": "listing.items"
          }
        },
        {
          "type": "section",
          "title": "Accessible campaigns",
          "children": [
            {
              "type": "text",
              "value": {
                "state": "listing.summary.campagnes_accessibles"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "Accessible trial requests",
          "children": [
            {
              "type": "text",
              "value": {
                "state": "listing.summary.demandes_accessibles"
              }
            }
          ]
        },
        {
          "type": "section",
          "title": "First results attested",
          "children": [
            {
              "type": "text",
              "value": {
                "state": "listing.summary.premiers_resultats_confirmes"
              }
            }
          ]
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "campaign_revision": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      },
      "confirmation_resultat": {
        "type": "string"
      },
      "expected_revision": {
        "type": "string"
      },
      "jeu": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "permission": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "listing": {
        "type": "object"
      },
      "selected": {
        "type": "object"
      },
      "people": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "jeu": "usage",
    "expected_revision": "0",
    "campaign_revision": "0",
    "confirmation_manuelle": "non",
    "confirmation_resultat": "non",
    "permission": "read",
    "kind": "campaign",
    "phase": "en_cours",
    "listing": {
      "items": [],
      "message": "No list loaded.",
      "summary": {}
    },
    "selected": {
      "record": {},
      "prefill": {
        "jeu": "usage",
        "expected_revision": "0",
        "campaign_revision": "0",
        "confirmation_manuelle": "non",
        "confirmation_resultat": "non",
        "permission": "read",
        "kind": "campaign",
        "phase": "en_cours"
      },
      "message": "No record selected."
    },
    "people": {
      "people": []
    }
  },
  "events": [
    {
      "event_id": "refresh-usage",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-launch-summary",
        "input": {
          "jeu": "usage",
          "kind": "all"
        }
      },
      "result_to_state": "listing"
    },
    {
      "event_id": "refresh-qualification",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-launch-summary",
        "input": {
          "jeu": "qualification",
          "kind": "all"
        }
      },
      "result_to_state": "listing"
    },
    {
      "event_id": "save",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-launch-summary",
        "input": {
          "jeu": "{{ state.jeu }}"
        }
      },
      "result_to_state": "listing"
    }
  ]
}
