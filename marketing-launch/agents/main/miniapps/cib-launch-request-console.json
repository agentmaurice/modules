{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "cib-launch-request-console",
  "version": "2",
  "title": "Marketing — trial request",
  "description": "3. Select a ready campaign, then record a request with a stable trial ID. An identical replay creates no duplicate. Share the trial record for editing with the support person.",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "3. Select a ready campaign, then record a request with a stable trial ID. An identical replay creates no duplicate. Share the trial record for editing with the support person."
        },
        {
          "type": "text",
          "value": "Open the form by its title in the available interactions. Long fields are notes. The named owner grants no AM permissions."
        },
        {
          "type": "button",
          "label": "Refresh real work",
          "on_click": "refresh-usage"
        },
        {
          "type": "button",
          "label": "Refresh trials",
          "on_click": "refresh-qualification"
        },
        {
          "type": "text",
          "value": {
            "state": "listing.message"
          }
        },
        {
          "type": "table",
          "columns": [
            "kind_label",
            "id",
            "phase_label",
            "revision",
            "objectif"
          ],
          "column_labels": {
            "kind_label": "Type",
            "id": "ID",
            "phase_label": "Stage",
            "revision": "Revision",
            "objectif": "Objective"
          },
          "rows": {
            "state": "listing.items"
          },
          "on_row_click": "select"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.message"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.permissions_summary"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.objectif"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.resultat_observe"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.preuve_ref"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "besoin": {
        "type": "string"
      },
      "campaign_id": {
        "type": "string"
      },
      "campaign_revision": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      },
      "confirmation_resultat": {
        "type": "string"
      },
      "expected_revision": {
        "type": "string"
      },
      "jeu": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "objectif": {
        "type": "string"
      },
      "permission": {
        "type": "string"
      },
      "personne_ref": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "trial_id": {
        "type": "string"
      },
      "listing": {
        "type": "object"
      },
      "selected": {
        "type": "object"
      },
      "people": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "jeu": "usage",
    "campaign_id": "",
    "campaign_revision": "0",
    "trial_id": "",
    "personne_ref": "",
    "besoin": "",
    "objectif": "",
    "confirmation_manuelle": "non",
    "expected_revision": "0",
    "confirmation_resultat": "non",
    "permission": "read",
    "kind": "campaign",
    "phase": "en_cours",
    "listing": {
      "items": [],
      "message": "No list loaded.",
      "summary": {}
    },
    "selected": {
      "record": {},
      "prefill": {
        "jeu": "usage",
        "campaign_id": "",
        "campaign_revision": "0",
        "trial_id": "",
        "personne_ref": "",
        "besoin": "",
        "objectif": "",
        "confirmation_manuelle": "non",
        "expected_revision": "0",
        "confirmation_resultat": "non",
        "permission": "read",
        "kind": "campaign",
        "phase": "en_cours"
      },
      "message": "No record selected."
    },
    "people": {
      "people": []
    }
  },
  "events": [
    {
      "event_id": "refresh-usage",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-launch-list",
        "input": {
          "jeu": "usage",
          "kind": "all"
        }
      },
      "result_to_state": "listing"
    },
    {
      "event_id": "refresh-qualification",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "cib-launch-list",
        "input": {
          "jeu": "qualification",
          "kind": "all"
        }
      },
      "result_to_state": "listing"
    },
    {
      "event_id": "select",
      "trigger": "table.row_click",
      "workflow": {
        "workflow_id": "cib-launch-read",
        "input": {
          "jeu": "{{ event.payload.item.jeu }}",
          "kind": "{{ event.payload.item.kind }}",
          "id": "{{ event.payload.item.id }}",
          "form_id": "request"
        }
      },
      "result_to_state": "selected"
    },
    {
      "event_id": "save",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "cib-launch-request",
        "input": {
          "jeu": "{{ state.jeu }}",
          "campaign_id": "{{ state.campaign_id }}",
          "campaign_revision": "{{ state.campaign_revision }}",
          "trial_id": "{{ state.trial_id }}",
          "personne_ref": "{{ state.personne_ref }}",
          "besoin": "{{ state.besoin }}",
          "objectif": "{{ state.objectif }}",
          "confirmation_manuelle": "{{ state.confirmation_manuelle }}"
        }
      },
      "result_to_state": "selected"
    }
  ]
}
