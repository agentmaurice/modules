{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "veille-sharing-console",
  "title": "Watch — record sharing",
  "description": "Manage access to selected records. Select a record, close the read form with Cancel, refresh members, select a member, then open the sharing form.",
  "version": "2",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Watch flow: select a record, close the read form with Cancel, refresh members, select a member, then open “Watch — share or remove access”."
        },
        {
          "type": "text",
          "value": "Sharing confirmation is separate from saving and resets to No after the operation."
        },
        {
          "type": "text",
          "value": "Sharing a record does not grant access to the service."
        },
        {
          "type": "text",
          "value": "Manual mode: user-provided data; no automatic research or publication."
        },
        {
          "type": "button",
          "label": "Refresh records",
          "on_click": "refresh"
        },
        {
          "type": "button",
          "label": "Refresh members",
          "on_click": "people"
        },
        {
          "type": "table",
          "columns": [
            "id"
          ],
          "column_labels": {
            "id": "Record"
          },
          "rows": {
            "state": "listing.items"
          },
          "on_row_click": "select"
        },
        {
          "type": "text",
          "value": "Company"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.entreprise"
          }
        },
        {
          "type": "text",
          "value": "Status"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.display.status"
          }
        },
        {
          "type": "text",
          "value": "Source"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.source_ref"
          }
        },
        {
          "type": "text",
          "value": "Source date"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.source_date"
          }
        },
        {
          "type": "text",
          "value": "Facts"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.faits"
          }
        },
        {
          "type": "text",
          "value": "Evidence"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.record.preuve_ref"
          }
        },
        {
          "type": "text",
          "value": "Proposed role"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.display.worker"
          }
        },
        {
          "type": "text",
          "value": "Evidence review"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.display.verdict"
          }
        },
        {
          "type": "text",
          "value": "Revision"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.revision"
          }
        },
        {
          "type": "text",
          "value": "Owner"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.owner_user_id"
          }
        },
        {
          "type": "text",
          "value": "Permissions"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.permissions_summary"
          }
        },
        {
          "type": "text",
          "value": "Shares"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.share_count"
          }
        },
        {
          "type": "section",
          "title": "Share the selected record",
          "children": [
            {
              "type": "text",
              "value": "Record associated with members"
            },
            {
              "type": "text",
              "value": {
                "state": "people.dossier_id"
              }
            },
            {
              "type": "text",
              "value": "Refresh members after selecting a record."
            },
            {
              "type": "text",
              "value": "Members available for sharing"
            },
            {
              "type": "table",
              "columns": [
                "user_id",
                "display_name"
              ],
              "column_labels": {
                "user_id": "Identifiant",
                "display_name": "Member"
              },
              "rows": {
                "state": "people.people"
              },
              "on_row_click": "select-person"
            },
            {
              "type": "text",
              "value": "Selected member"
            },
            {
              "type": "text",
              "value": {
                "state": "people.selected_target.display_name"
              }
            },
            {
              "type": "text",
              "value": "Selected permission"
            },
            {
              "type": "text",
              "value": {
                "state": "share_permission"
              }
            },
            {
              "type": "text",
              "value": "Sharing confirmation is separate from saving and resets to No after the operation."
            },
            {
              "type": "text",
              "value": "Sharing a record does not grant access to the service."
            }
          ]
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "dossier_id": {
        "type": "string"
      },
      "entreprise": {
        "type": "string"
      },
      "source_ref": {
        "type": "string"
      },
      "source_date": {
        "type": "string"
      },
      "date_revue": {
        "type": "string"
      },
      "faits": {
        "type": "string"
      },
      "preuve_ref": {
        "type": "string"
      },
      "role_demande": {
        "type": "string"
      },
      "contradiction": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      },
      "result": {
        "type": "object"
      },
      "selected": {
        "type": "object"
      },
      "listing": {
        "type": "object"
      },
      "share_permission": {
        "type": "string"
      },
      "share_confirmation_manuelle": {
        "type": "string"
      },
      "people": {
        "type": "object"
      },
      "share_dossier_id": {
        "type": "string"
      },
      "share_expected_revision": {
        "type": "string"
      },
      "share_subject_user_id": {
        "type": "string"
      }
    }
  },
  "initial_state": {
    "dossier_id": "",
    "entreprise": "",
    "source_ref": "",
    "source_date": "",
    "date_revue": "",
    "faits": "",
    "preuve_ref": "",
    "role_demande": "",
    "contradiction": "non",
    "confirmation_manuelle": "non",
    "result": {
      "record": {}
    },
    "selected": {
      "record": {},
      "revision": 0,
      "owner_user_id": "",
      "permissions": {},
      "shares": [],
      "permissions_summary": "Read: no · Write: no · Share: no",
      "share_count": 0,
      "display": {
        "status": "",
        "worker": "",
        "verdict": "",
        "review": ""
      }
    },
    "listing": {
      "items": []
    },
    "share_permission": "read",
    "share_confirmation_manuelle": "non",
    "people": {
      "people": [],
      "selected_target": null,
      "dossier_id": ""
    },
    "share_dossier_id": "",
    "share_expected_revision": "",
    "share_subject_user_id": ""
  },
  "events": [
    {
      "event_id": "refresh",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "veille-list",
        "input": {}
      },
      "result_to_state": "listing"
    },
    {
      "event_id": "select",
      "trigger": "table.row_click",
      "workflow": {
        "workflow_id": "veille-read",
        "input": {
          "dossier_id": "{{ event.payload.item.id }}"
        }
      },
      "result_to_state": "selected"
    },
    {
      "event_id": "people",
      "trigger": "action.click",
      "workflow": {
        "workflow_id": "veille-people",
        "input": {
          "dossier_id": "{{ state.selected.record.id }}"
        }
      },
      "result_to_state": "people"
    },
    {
      "event_id": "select-person",
      "trigger": "table.row_click",
      "workflow": {
        "workflow_id": "veille-people",
        "input": {
          "dossier_id": "{{ state.selected.record.id }}",
          "subject_user_id": "{{ event.payload.item.user_id }}"
        }
      },
      "result_to_state": "people"
    },
    {
      "event_id": "share",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "veille-share",
        "input": {
          "share_dossier_id": "{{ state.selected.record.id }}",
          "share_expected_revision": "{{ state.selected.revision }}",
          "share_subject_user_id": "{{ state.people.selected_target.user_id }}",
          "share_permission": "{{ state.share_permission }}",
          "share_confirmation_manuelle": "{{ state.share_confirmation_manuelle }}",
          "selection_dossier_id": "{{ state.people.dossier_id }}"
        }
      },
      "result_to_state": "selected"
    }
  ]
}
