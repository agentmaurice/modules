{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "daily-report-console",
  "version": "2",
  "title": "Time briefing and report",
  "description": "Internal manual routine; no sending or publication.",
  "ui": {
    "renderer": "component",
    "component": "daily-routine",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Descriptive report: test data does not prove a real gain. Both periods must be included."
        },
        {
          "type": "text",
          "value": {
            "state": "result.message"
          }
        },
        {
          "type": "metric",
          "label": "Recurring gain (minutes)",
          "value": {
            "state": "result.summary.gain_minutes"
          }
        },
        {
          "type": "metric",
          "label": "Setup (minutes)",
          "value": {
            "state": "result.summary.installation_minutes"
          }
        },
        {
          "type": "metric",
          "label": "Total human time (minutes)",
          "value": {
            "state": "result.summary.total_temps_humain_minutes"
          }
        },
        {
          "type": "text",
          "value": "Measurements excluded from comparison"
        },
        {
          "type": "table",
          "columns": [
            "comparaison_id",
            "reason_label"
          ],
          "column_labels": {
            "comparaison_id": "Comparison",
            "reason_label": "Reason"
          },
          "rows": {
            "state": "result.exclusions"
          }
        },
        {
          "type": "table",
          "columns": [
            "session_id",
            "date",
            "phase_label",
            "dossier_id",
            "quality_label",
            "temps_humain_minutes",
            "prochaine_etape"
          ],
          "column_labels": {
            "session_id": "Measurement",
            "date": "Date",
            "phase_label": "Method",
            "dossier_id": "Case",
            "quality_label": "Quality",
            "temps_humain_minutes": "Human minutes",
            "prochaine_etape": "Next step"
          },
          "rows": {
            "state": "result.items"
          },
          "on_row_click": "select"
        },
        {
          "type": "text",
          "value": "Selected measurement"
        },
        {
          "type": "text",
          "value": {
            "state": "selected.content"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "jeu": {
        "type": "string"
      },
      "date_debut": {
        "type": "string"
      },
      "date_fin": {
        "type": "string"
      },
      "result": {
        "type": "object"
      },
      "listing": {
        "type": "object"
      },
      "selected": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "jeu": "usage",
    "date_debut": "",
    "date_fin": "",
    "result": {
      "items": [],
      "exclusions": [],
      "message": "No period viewed."
    },
    "listing": {
      "items": []
    },
    "selected": {
      "content": ""
    }
  },
  "events": [
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "daily-report",
        "input": {
          "jeu": "{{ state.jeu }}",
          "date_debut": "{{ state.date_debut }}",
          "date_fin": "{{ state.date_fin }}"
        }
      },
      "result_to_state": "result"
    },
    {
      "event_id": "select",
      "trigger": "table.row_click",
      "workflow": {
        "workflow_id": "daily-time-read",
        "input": {
          "session_id": "{{ event.payload.item.session_id }}",
          "jeu": "{{ state.jeu }}"
        }
      },
      "result_to_state": "selected"
    }
  ]
}
