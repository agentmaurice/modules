{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "daily-context-console",
  "version": "2",
  "title": "My routine — case and memory",
  "description": "Internal manual routine; no sending or publication.",
  "ui": {
    "renderer": "component",
    "component": "daily-routine",
    "configuration": {
      "layout": [
        {
          "type": "steps",
          "items": [
            {
              "title": "Choose a case",
              "description": "Watch: dated source. Content: internal draft. Support: next assistance to prepare.",
              "status": "todo"
            },
            {
              "title": "View memory",
              "description": "Find a revision and check its date and citations.",
              "status": "todo"
            },
            {
              "title": "Prepare and review",
              "description": "Use the role screens. A prepared draft does not prove publication or a successful trial.",
              "status": "todo"
            },
            {
              "title": "Record time and feedback",
              "description": "Record time, then propose an excerpt to memory. Memory review remains separate.",
              "status": "todo"
            }
          ]
        },
        {
          "type": "text",
          "value": {
            "state": "result.message"
          }
        },
        {
          "type": "text",
          "value": "Local case"
        },
        {
          "type": "text",
          "value": {
            "state": "result.content"
          }
        },
        {
          "type": "text",
          "value": "Memory"
        },
        {
          "type": "text",
          "value": {
            "state": "result.memory_status"
          }
        },
        {
          "type": "text",
          "value": {
            "state": "result.memory_answer"
          }
        },
        {
          "type": "text",
          "value": "Revision"
        },
        {
          "type": "text",
          "value": {
            "state": "result.proposal_id"
          }
        },
        {
          "type": "text",
          "value": "Sources"
        },
        {
          "type": "text",
          "value": {
            "state": "result.citations"
          }
        },
        {
          "type": "text",
          "value": "Review before"
        },
        {
          "type": "text",
          "value": {
            "state": "result.expires_at"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "dossier_id": {
        "type": "string"
      },
      "proposal_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      },
      "listing": {
        "type": "object"
      },
      "selected": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "dossier_id": "",
    "proposal_id": "",
    "result": {
      "message": "No entry recorded."
    },
    "listing": {
      "items": []
    },
    "selected": {
      "content": ""
    }
  },
  "events": [
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "daily-context",
        "input": {
          "dossier_id": "{{ state.dossier_id }}",
          "proposal_id": "{{ state.proposal_id }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
