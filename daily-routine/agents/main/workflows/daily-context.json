{
  "$schema": "agentmaurice.workflow/v2",
  "schema_version": 2,
  "kind": "workflow",
  "workflow_id": "daily-context",
  "version": "2",
  "title": "Prepare my case with memory",
  "actions": [
    {
      "id": "dossier",
      "type": "workflow_call",
      "workflow_id": "daily-role-read",
      "workflow_version": "3",
      "execution": "sync",
      "input": {
        "dossier_id": "{{ dossier_id }}"
      },
      "output_key": "local"
    },
    {
      "id": "memory",
      "type": "workflow_call",
      "workflow_id": "company-memory-query",
      "workflow_version": "2",
      "execution": "sync",
      "input": {
        "proposal_id": "{{ proposal_id }}"
      },
      "output_key": "memory"
    },
    {
      "id": "context",
      "type": "code_execution",
      "code": "const r=({{ json .local }}).data.record;const m=({{ json .memory }}).data;const valid=m.status===\"validated\"&&typeof m.answer===\"string\"&&m.answer.trim()&&Array.isArray(m.citations)&&m.citations.length>0&&Number.isFinite(Date.parse(m.expires_at))&&Date.parse(m.expires_at)>Date.now();return {dossier:r,content:JSON.stringify(r,null,2),memory_status:m.status,memory_answer:valid?m.answer:\"Memory cannot be used: review is required.\",citations:valid?m.citations:[],proposal_id:m.proposal_id,expires_at:m.expires_at||\"\",ready:!!valid,message:valid?\"Context available. Prepare and review the internal deliverable before recording time.\":\"Memory is unvalidated or expired: do not use it as fact. Return to collection or memory review.\"};",
      "output_key": "context"
    }
  ],
  "output": {
    "dossier": "{{ context.dossier }}",
    "content": "{{ context.content }}",
    "memory_status": "{{ context.memory_status }}",
    "memory_answer": "{{ context.memory_answer }}",
    "citations": "{{ context.citations }}",
    "proposal_id": "{{ context.proposal_id }}",
    "expires_at": "{{ context.expires_at }}",
    "ready": "{{ context.ready }}",
    "message": "{{ context.message }}",
    "manual_only": true,
    "external_effect": false
  },
  "forms": [
    {
      "id": "submit",
      "title": "Prepare my case with memory",
      "fields": [
        {
          "name": "dossier_id",
          "title": "Local case",
          "type": "string",
          "required": true
        },
        {
          "name": "proposal_id",
          "title": "Memory revision to view",
          "type": "string",
          "required": true
        }
      ],
      "actions_on_submit": [
        "dossier",
        "memory",
        "context"
      ]
    }
  ]
}
