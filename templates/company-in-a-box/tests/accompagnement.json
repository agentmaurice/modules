{
  "$schema": "agentmaurice.test_plan/v2",
  "schema_version": 2,
  "test_plan_id": "accompagnement",
  "cases": [
    {
      "id": "save-happy",
      "description": "Technical execution without human identity: the ACL broker must refuse access. Positive cases are verified with existing accounts from the CIB surface.",
      "workflow": {
        "workflow_id": "accompagnement-save",
        "input": {
          "dossier_id": "dossier-acme-001",
          "entreprise": "Acme",
          "objectif": "Prepare follow-up",
          "resultat_observe": "",
          "preuve_ref": "note-interne-001",
          "blocage": "",
          "prochaine_etape": "Revoir le dossier",
          "confirmation_manuelle": true
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": "failed"
        }
      ]
    },
    {
      "id": "read-happy",
      "description": "Technical execution without human identity: the ACL broker must refuse access. Positive cases are verified with existing accounts from the CIB surface.",
      "workflow": {
        "workflow_id": "accompagnement-read",
        "input": {
          "dossier_id": "dossier-acme-001"
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": "failed"
        }
      ]
    },
    {
      "id": "guard-external-confirmed",
      "description": "An external action remains refused even with confirmation.",
      "workflow": {
        "workflow_id": "accompagnement-guard-action",
        "input": {
          "action": "external_send",
          "confirmation_manuelle": true
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": "completed"
        },
        {
          "type": "result_jsonpath",
          "path": "$.decision",
          "operator": "equals",
          "expected": "deny"
        }
      ]
    },
    {
      "id": "guard-missing-confirmation",
      "description": "Sans confirmation, l'enregistrement attend une approbation humaine.",
      "workflow": {
        "workflow_id": "accompagnement-guard-action",
        "input": {
          "action": "save_internal_draft",
          "confirmation_manuelle": false
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": "completed"
        },
        {
          "type": "result_jsonpath",
          "path": "$.decision",
          "operator": "equals",
          "expected": "waiting_for_approval"
        }
      ]
    },
    {
      "id": "read-id-traversal",
      "description": "Technical execution without human identity: the ACL broker must refuse access. Positive cases are verified with existing accounts from the CIB surface.",
      "workflow": {
        "workflow_id": "accompagnement-read",
        "input": {
          "dossier_id": "../secret"
        }
      },
      "assertions": [
        {
          "type": "status",
          "expected": "failed"
        }
      ]
    }
  ]
}
