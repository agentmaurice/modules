{
  "$schema": "agentmaurice.miniapp/v2",
  "schema_version": 2,
  "kind": "miniapp",
  "miniapp_id": "contenu-memory-draft-console",
  "version": "2",
  "title": "Content — Draft from a validated revision",
  "ui": {
    "renderer": "component",
    "component": "company-in-a-box",
    "configuration": {
      "layout": [
        {
          "type": "text",
          "value": "Manual mode. Contributions remain proposed until reviewed in the memory Module."
        },
        {
          "type": "text",
          "value": "Internal draft"
        },
        {
          "type": "text",
          "value": {
            "state": "result.record.brouillon"
          }
        },
        {
          "type": "text",
          "value": "Revision used"
        },
        {
          "type": "text",
          "value": {
            "state": "result.proposal_id"
          }
        }
      ]
    }
  },
  "state_schema": {
    "type": "object",
    "properties": {
      "dossier_id": {
        "type": "string"
      },
      "entreprise": {
        "type": "string"
      },
      "sujet": {
        "type": "string"
      },
      "proposal_id": {
        "type": "string"
      },
      "confirmation_manuelle": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "initial_state": {
    "dossier_id": "",
    "entreprise": "",
    "sujet": "",
    "proposal_id": "",
    "confirmation_manuelle": "non",
    "result": {}
  },
  "events": [
    {
      "event_id": "submit",
      "trigger": "form.submit",
      "workflow": {
        "workflow_id": "contenu-memory-draft",
        "input": {
          "dossier_id": "{{ state.dossier_id }}",
          "entreprise": "{{ state.entreprise }}",
          "sujet": "{{ state.sujet }}",
          "proposal_id": "{{ state.proposal_id }}",
          "confirmation_manuelle": "{{ state.confirmation_manuelle }}"
        }
      },
      "result_to_state": "result"
    }
  ]
}
